PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lab-rec
ADMIN_PASSWORD=change-me

# Optional — enables AI-powered "related chemical" suggestions on the Search page.
# Without it, suggestions fall back to local name/formula similarity matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
